# Copy this file to a local, ignored env file and supply environment-specific values.
SPRING_PROFILES_ACTIVE=local
APP_AUTH_MODE=legacy

MONGODB_URI=<set-locally>
MONGODB_DATABASE=<set-locally>
REDIS_HOST=<set-locally>
REDIS_PORT=6379

# Base URL only. Learning Core appends the existing /evaluations path.
AI_SERVER_URL=http://tosunsaeng-ai:8000

AWS_REGION=ap-northeast-2
AWS_S3_BUCKET_NAME=<set-locally>

# TMI-116 is default-off. BILLING_BASE_URL is required only when enabled.
BILLING_CREATION_SAGA_ENABLED=false
BILLING_BASE_URL=<set-locally>
BILLING_AWS_REGION=ap-northeast-2
BILLING_CONNECT_TIMEOUT=PT2S
BILLING_READ_TIMEOUT=PT5S

# Required only when APP_AUTH_MODE=jwt.
IDENTITY_ISSUER=<set-locally>
IDENTITY_JWK_SET_URI=<set-locally>
IDENTITY_AUDIENCE=<set-locally>
IDENTITY_CLOCK_SKEW=PT60S

# Disabled until the workload JWT profile and retention values are approved.
USER_WITHDRAWN_CONSUMER_ENABLED=false
USER_WITHDRAWN_DENY_GATE_ENABLED=false
USER_WITHDRAWN_MAX_ACCESS_TOKEN_LIFETIME=PT30M
USER_WITHDRAWN_ALLOWED_VERIFIER_CLOCK_SKEW=PT60S
USER_WITHDRAWN_INBOX_RETENTION=P120D
USER_WITHDRAWN_MAXIMUM_FUTURE_EVENT_SKEW=PT60S
USER_WITHDRAWN_WORKLOAD_ISSUER=<set-locally>
USER_WITHDRAWN_WORKLOAD_JWK_SET_URI=<set-locally>
USER_WITHDRAWN_WORKLOAD_AUDIENCE=<set-locally>
USER_WITHDRAWN_WORKLOAD_PRINCIPAL_CLAIM=<set-locally>
USER_WITHDRAWN_WORKLOAD_PRINCIPAL_VALUE=<set-locally>
USER_WITHDRAWN_WORKLOAD_MAX_TOKEN_LIFETIME=PT5M
USER_WITHDRAWN_WORKLOAD_CLOCK_SKEW=PT30S

# AWS credentials are intentionally omitted. Use an AWS CLI/SSO profile locally
# or an ECS Task Role in AWS.
