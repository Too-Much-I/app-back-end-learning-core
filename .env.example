# Copy this file to a local, ignored env file and supply environment-specific values.
SPRING_PROFILES_ACTIVE=local
APP_AUTH_MODE=legacy

MONGODB_URI=<set-locally>
MONGODB_DATABASE=<set-locally>
REDIS_HOST=<set-locally>
REDIS_PORT=6379

AWS_REGION=ap-northeast-2
AWS_S3_BUCKET_NAME=<set-locally>

# Required only when APP_AUTH_MODE=jwt.
IDENTITY_ISSUER=<set-locally>
IDENTITY_JWK_SET_URI=<set-locally>
IDENTITY_AUDIENCE=<set-locally>

# Expo Push is disabled by default. Keep the access token in a secret store when enabled.
PUSH_NOTIFICATIONS_ENABLED=false
PUSH_PROVIDER=expo
EXPO_PUSH_ACCESS_TOKEN=
PUSH_WORKER_DELAY_MS=5000
PUSH_RECEIPT_DELAY_SECONDS=900
PUSH_LEASE_DURATION_SECONDS=120
PUSH_MAX_ATTEMPTS=5

# AWS credentials are intentionally omitted. Use an AWS CLI/SSO profile locally
# or an ECS Task Role in AWS.
