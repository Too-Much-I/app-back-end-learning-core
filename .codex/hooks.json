{
  "description": "Learning Core current-state and append-only worklog hooks.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/load_current_state.py\"",
            "timeout": 10,
            "statusMessage": "Loading Learning Core current state"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/inject_worklog_instruction.py\"",
            "timeout": 10,
            "statusMessage": "Preparing Learning Core worklog instruction"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/enforce_worklog.py\"",
            "timeout": 15,
            "statusMessage": "Checking Learning Core worklog"
          }
        ]
      }
    ]
  }
}
