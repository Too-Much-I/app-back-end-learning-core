        <mxCell id="PcUH3bl3Y4UZZlcKv1d9-32" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;시험 세션 생성&lt;/span&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;시험에 대한 세션을 생성&lt;/span&gt;&lt;/h1&gt;&lt;div&gt;세션을 통해서 유저의 시험 기록 및 점수에 대한 이력 관리&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="180" x="307.5" y="170" as="geometry" />
