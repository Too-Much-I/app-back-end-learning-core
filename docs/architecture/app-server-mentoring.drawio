        <mxCell id="reserve" value="4. 임시 hold&#xa;Reservation RESERVED&#xa;Allocation HELD&#xa;Ledger RESERVED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1020" y="160" width="250" height="125" as="geometry" />
